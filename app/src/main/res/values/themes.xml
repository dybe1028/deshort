<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="Theme.Deshort" parent="android:Theme.Material.Light.NoActionBar" />

    <!-- Base style for a single keyboard letter key -->
    <style name="KeyButton">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">52dp</item>
        <item name="android:layout_weight">1</item>
        <item name="android:layout_marginStart">3dp</item>
        <item name="android:layout_marginEnd">3dp</item>
        <item name="android:layout_marginLeft">3dp</item>
        <item name="android:layout_marginRight">3dp</item>
        <item name="android:layout_marginTop">4dp</item>
        <item name="android:layout_marginBottom">4dp</item>
        <item name="android:background">@drawable/bg_key_letter</item>
        <item name="android:textColor">@color/key_text_color</item>
        <item name="android:textSize">18sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:padding">0dp</item>
        <item name="android:stateListAnimator">@null</item>
    </style>

    <!-- Wider key for Backspace -->
    <style name="KeyButtonWide" parent="KeyButton">
        <item name="android:layout_weight">1.8</item>
        <item name="android:background">@drawable/bg_key_special</item>
        <item name="android:textColor">@color/key_text_special</item>
        <item name="android:textSize">15sp</item>
    </style>

    <!-- Shift key with active state handling -->
    <style name="KeyButtonShift" parent="KeyButtonWide">
        <item name="android:layout_weight">1.5</item>
        <item name="android:background">@drawable/bg_key_shift</item>
    </style>

    <!-- Enter key style -->
    <style name="KeyButtonEnter" parent="KeyButtonWide">
        <item name="android:layout_weight">2.0</item>
        <item name="android:background">@drawable/bg_key_special</item>
    </style>

    <!-- Space bar style -->
    <style name="KeyButtonSpace" parent="KeyButton">
        <item name="android:layout_weight">5.0</item>
        <item name="android:background">@drawable/bg_key_space</item>
        <item name="android:textColor">@color/key_text_space</item>
        <item name="android:textSize">14sp</item>
    </style>

</resources>