<?xml version="1.0" encoding="utf-8"?>
<!--
    Clipboard Panel — shown when user taps the clipboard toolbar button.
    Structure:
      - Header: title + clear-all button
      - Scrollable list of clipboard items
      - Back button
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/clipboard_panel"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/keyboard_background"
    android:orientation="vertical"
    android:minHeight="200dp">

    <!-- Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:background="@color/toolbar_background"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="12dp"
        android:paddingEnd="8dp">

        <Button
            android:id="@+id/clipboard_back_btn"
            style="@style/KeyButtonWide"
            android:layout_width="wrap_content"
            android:layout_height="32dp"
            android:text="ABC"
            android:textSize="12sp" />

        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Clipboard"
            android:textColor="@color/toolbar_text"
            android:textSize="13sp"
            android:textStyle="bold" />

        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <Button
            android:id="@+id/clipboard_clear_btn"
            style="@style/KeyButtonWide"
            android:layout_width="wrap_content"
            android:layout_height="32dp"
            android:text="Clear all"
            android:textSize="11sp" />
    </LinearLayout>

    <!-- Empty state label -->
    <TextView
        android:id="@+id/clipboard_empty_label"
        android:layout_width="match_parent"
        android:layout_height="160dp"
        android:gravity="center"
        android:text="No clipboard items saved.\nCopy text to add items."
        android:textAlignment="center"
        android:textColor="@color/toolbar_text"
        android:textSize="13sp"
        android:visibility="gone" />

    <!-- Scrollable item list -->
    <ScrollView
        android:id="@+id/clipboard_scroll"
        android:layout_width="match_parent"
        android:layout_height="160dp"
        android:scrollbars="vertical"
        android:visibility="gone">

        <LinearLayout
            android:id="@+id/clipboard_items_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="6dp"
            android:paddingEnd="6dp"
            android:paddingTop="4dp"
            android:paddingBottom="4dp" />
    </ScrollView>

</LinearLayout>
